# Use demo data when Supabase is not connected.
VITE_DEMO_MODE=true

# Supabase Connect dialog values. Never place a secret or service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CLOSET_WORKSPACE_ID=00000000-0000-0000-0000-000000000003

# Optional build metadata shown in Settings.
VITE_APP_VERSION=0.1.0
VITE_DATA_VERSION=notion-snapshot

# Local development experiment only. Production builds ignore this flag.
VITE_P5A_CONTEXT_RANKING=false
